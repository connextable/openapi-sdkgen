#!/usr/bin/env bash
set -euo pipefail
source "$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)/scripts/agent/lib.sh"

test_root="$(mktemp -d "${TMPDIR:-/tmp}/openapi-sdkgen-generate-check-test.XXXXXX")"
test_tmp="$test_root/tmp"
mock_bin="$test_root/bin"
mkdir -p "$test_tmp" "$mock_bin"
server_pid=""

cleanup() {
  if [[ -n "$server_pid" ]]; then
    kill "$server_pid" 2>/dev/null || true
    wait "$server_pid" 2>/dev/null || true
  fi
  rm -rf "$test_root"
}
trap cleanup EXIT

fail() {
  echo "generate-check test: $*" >&2
  exit 1
}

assert_contains() {
  local value="$1"
  local expected="$2"
  if [[ "$value" != *"$expected"* ]]; then
    printf '%s\n' "$value" >&2
    fail "expected output to contain: $expected"
  fi
}

assert_clean_temporary_root() {
  if find "$test_tmp" -maxdepth 1 -name 'openapi-sdkgen-generate-check.*' -print | grep -q .; then
    find "$test_tmp" -maxdepth 1 -name 'openapi-sdkgen-generate-check.*' -print >&2
    fail "generate-check temporary directory was not removed"
  fi
}

input="$test_root/openapi.json"
cat >"$input" <<'EOF'
{
  "openapi": "3.2.0",
  "info": {"title": "Generate Check", "version": "1.0.0"},
  "paths": {"/items": {"get": {"operationId": "list-items", "responses": {"204": {"description": "OK"}}}}},
  "components": {"schemas": {"Item": {"type": "object", "properties": {"id": {"type": "string"}}}}}
}
EOF

agent_run "build generate-check CLI" go build -o "$test_root/openapi-sdkgen" ./cmd/openapi-sdkgen
agent_run "build generate-check snapshot helper" go build -o "$test_root/snapshot" ./scripts/generate-check/snapshot
agent_run "build generate-check HTTP fixture" go build -o "$test_root/testserver" ./scripts/generate-check/testserver

cat >"$mock_bin/acquire" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
input=""
data_output=""
base_output=""
report_output=""
while (($# > 0)); do
  case "$1" in
    --input) input="$2"; shift 2 ;;
    --data-output) data_output="$2"; shift 2 ;;
    --base-output) base_output="$2"; shift 2 ;;
    --report-output) report_output="$2"; shift 2 ;;
    *) shift ;;
  esac
done
cp "$input" "$data_output"
printf '%s' "$input" >"$base_output"
printf '{"input":"%s","sha256":"mock","title":"Generate Check","version":"1.0.0","openapiVersion":"3.2.0","operationCount":1,"componentCount":1}\n' "$input" >"$report_output"
if [[ "${GENERATE_CHECK_TEST_MUTATE_INPUT:-0}" == "1" ]]; then
  printf '{"openapi":"3.2.0","info":{"title":"Changed","version":"2"},"paths":{}}\n' >"$input"
fi
EOF

cat >"$mock_bin/generator" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf '%s\n' "$*" >"${GENERATE_CHECK_TEST_GENERATOR_ARGS:?}"
if [[ -n "${GENERATE_CHECK_TEST_GENERATOR_ARGV:-}" ]]; then
  printf '%s\n' "$@" >"$GENERATE_CHECK_TEST_GENERATOR_ARGV"
fi
snapshot="$(mktemp)"
trap 'rm -f "$snapshot"' EXIT
cat >"$snapshot"
cp "$snapshot" "${GENERATE_CHECK_TEST_GENERATOR_STDIN:?}"
if [[ "${GENERATE_CHECK_TEST_GENERATOR_STATUS:-0}" != "0" ]]; then
  exit "$GENERATE_CHECK_TEST_GENERATOR_STATUS"
fi
output=""
while (($# > 0)); do
  if [[ "$1" == "--output" ]]; then output="$2"; shift 2; continue; fi
  shift
done
mkdir -p "$output"
if [[ "${GENERATE_CHECK_TEST_MISSING_SLOT:-0}" == "1" ]]; then
  pagination=""
else
  pagination='readonly pagination: never;'
fi
cat >"$output/index.ts" <<EOF_TS
export interface Components {
  readonly "Item": { readonly input: unknown; readonly output: unknown }
}
export interface Operations {
  readonly "list-items": {
    readonly input: unknown
    readonly resourceInput: unknown
    readonly options: unknown
    readonly output: unknown
    readonly error: unknown
    readonly rawResponse: unknown
    readonly call: { readonly raw: unknown }
    readonly resourceCall: unknown
    $pagination
  }
}
export interface Client {
  readonly \$operations: { readonly "list-items": Operations["list-items"]["call"] }
}
export declare function createClient(options?: unknown): Client
EOF_TS
EOF

cat >"$mock_bin/tsc" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf '%s\n' "$*" >"${GENERATE_CHECK_TEST_TSC_ARGS:?}"
exit "${GENERATE_CHECK_TEST_TSC_STATUS:-0}"
EOF
chmod 755 "$mock_bin/acquire" "$mock_bin/generator" "$mock_bin/tsc"

real_output="$(
  TMPDIR="$test_tmp" \
  SDKGEN_GENERATE_CHECK_SKIP_BUILD=1 \
  SDKGEN_GENERATE_CHECK_ACQUIRE_BIN="$test_root/snapshot" \
  SDKGEN_GENERATE_CHECK_GENERATOR_BIN="$test_root/openapi-sdkgen" \
  "$ROOT/scripts/agent/generate-check" "$input"
)"
assert_contains "$real_output" '"title": "Generate Check"'
assert_contains "$real_output" "generation exit: 0"
assert_contains "$real_output" "typecheck exit: 0"
assert_clean_temporary_root

real_server_output="$(
  TMPDIR="$test_tmp" \
  SDKGEN_GENERATE_CHECK_SKIP_BUILD=1 \
  SDKGEN_GENERATE_CHECK_ACQUIRE_BIN="$test_root/snapshot" \
  SDKGEN_GENERATE_CHECK_GENERATOR_BIN="$test_root/openapi-sdkgen" \
  "$ROOT/scripts/agent/generate-check" "$input" typescript -- --with server
)"
assert_contains "$real_server_output" "generation exit: 0"
assert_contains "$real_server_output" "typecheck exit: 0"
assert_clean_temporary_root

original="$test_root/original.json"
mutable="$test_root/mutable.json"
cp "$input" "$original"
cp "$input" "$mutable"
generator_args="$test_root/generator.args"
generator_stdin="$test_root/generator.stdin"
tsc_args="$test_root/tsc.args"
forward_output="$(
  TMPDIR="$test_tmp" \
  SDKGEN_GENERATE_CHECK_SKIP_BUILD=1 \
  SDKGEN_GENERATE_CHECK_ACQUIRE_BIN="$mock_bin/acquire" \
  SDKGEN_GENERATE_CHECK_GENERATOR_BIN="$mock_bin/generator" \
  SDKGEN_GENERATE_CHECK_TSC_BIN="$mock_bin/tsc" \
  GENERATE_CHECK_TEST_MUTATE_INPUT=1 \
  GENERATE_CHECK_TEST_GENERATOR_ARGS="$generator_args" \
  GENERATE_CHECK_TEST_GENERATOR_STDIN="$generator_stdin" \
  GENERATE_CHECK_TEST_TSC_ARGS="$tsc_args" \
  "$ROOT/scripts/agent/generate-check" "$mutable" custom-target -- --with server --schema-extension extension.json
)"
assert_contains "$(cat "$generator_args")" "--target custom-target"
assert_contains "$(cat "$generator_args")" "--with server"
assert_contains "$(cat "$generator_args")" "--schema-extension extension.json"
assert_contains "$(cat "$tsc_args")" "--project"
cmp "$original" "$generator_stdin" || fail "generation did not consume the acquired immutable snapshot"
assert_contains "$forward_output" "typecheck exit: 0"
assert_clean_temporary_root

generator_argv="$test_root/generator.argv"
injection_sentinel="$test_root/injected"
literal_extension="$test_root/schema extension;touch $injection_sentinel"
TMPDIR="$test_tmp" \
SDKGEN_GENERATE_CHECK_SKIP_BUILD=1 \
SDKGEN_GENERATE_CHECK_ACQUIRE_BIN="$mock_bin/acquire" \
SDKGEN_GENERATE_CHECK_GENERATOR_BIN="$mock_bin/generator" \
SDKGEN_GENERATE_CHECK_TSC_BIN="$mock_bin/tsc" \
GENERATE_CHECK_TEST_GENERATOR_ARGS="$generator_args" \
GENERATE_CHECK_TEST_GENERATOR_ARGV="$generator_argv" \
GENERATE_CHECK_TEST_GENERATOR_STDIN="$generator_stdin" \
GENERATE_CHECK_TEST_TSC_ARGS="$tsc_args" \
just agent generate-check "$input" typescript -- --schema-extension "$literal_extension" >/dev/null
grep -Fx -- "$literal_extension" "$generator_argv" >/dev/null || fail "just recipe did not preserve the literal variadic argument"
[[ ! -e "$injection_sentinel" ]] || fail "just recipe executed variadic shell syntax"
assert_clean_temporary_root

for owned in --input --input=unexpected -input -input=unexpected --input-base --input-base=unexpected -input-base -input-base=unexpected --output --output=unexpected -output -output=unexpected --target --target=unexpected -target -target=unexpected; do
  set +e
  owned_output="$(
    TMPDIR="$test_tmp" \
    SDKGEN_GENERATE_CHECK_SKIP_BUILD=1 \
    "$ROOT/scripts/agent/generate-check" "$input" typescript -- "$owned" unexpected 2>&1
  )"
  owned_status=$?
  set -e
  if ((owned_status != 2)); then
    fail "$owned override exit = $owned_status, want 2"
  fi
  assert_contains "$owned_output" "does not allow overriding"
  assert_clean_temporary_root
done

set +e
generation_failure="$(
  TMPDIR="$test_tmp" \
  SDKGEN_GENERATE_CHECK_SKIP_BUILD=1 \
  SDKGEN_GENERATE_CHECK_ACQUIRE_BIN="$mock_bin/acquire" \
  SDKGEN_GENERATE_CHECK_GENERATOR_BIN="$mock_bin/generator" \
  SDKGEN_GENERATE_CHECK_TSC_BIN="$mock_bin/tsc" \
  GENERATE_CHECK_TEST_GENERATOR_STATUS=23 \
  GENERATE_CHECK_TEST_GENERATOR_ARGS="$generator_args" \
  GENERATE_CHECK_TEST_GENERATOR_STDIN="$generator_stdin" \
  GENERATE_CHECK_TEST_TSC_ARGS="$tsc_args" \
  "$ROOT/scripts/agent/generate-check" "$input" 2>&1
)"
generation_status=$?
set -e
if ((generation_status != 23)); then
  fail "generation failure exit = $generation_status, want 23"
fi
assert_contains "$generation_failure" "generation exit: 23"
assert_contains "$generation_failure" "typecheck exit: not-run"
assert_clean_temporary_root

set +e
verbose_generation_failure="$(
  TMPDIR="$test_tmp" \
  VERBOSE=1 \
  SDKGEN_GENERATE_CHECK_SKIP_BUILD=1 \
  SDKGEN_GENERATE_CHECK_ACQUIRE_BIN="$mock_bin/acquire" \
  SDKGEN_GENERATE_CHECK_GENERATOR_BIN="$mock_bin/generator" \
  SDKGEN_GENERATE_CHECK_TSC_BIN="$mock_bin/tsc" \
  GENERATE_CHECK_TEST_GENERATOR_STATUS=23 \
  GENERATE_CHECK_TEST_GENERATOR_ARGS="$generator_args" \
  GENERATE_CHECK_TEST_GENERATOR_STDIN="$generator_stdin" \
  GENERATE_CHECK_TEST_TSC_ARGS="$tsc_args" \
  "$ROOT/scripts/agent/generate-check" "$input" 2>&1
)"
verbose_generation_status=$?
set -e
if ((verbose_generation_status != 23)); then
  fail "verbose generation failure exit = $verbose_generation_status, want 23"
fi
assert_contains "$verbose_generation_failure" "generation exit: 23"
assert_clean_temporary_root

set +e
typecheck_failure="$(
  TMPDIR="$test_tmp" \
  SDKGEN_GENERATE_CHECK_SKIP_BUILD=1 \
  SDKGEN_GENERATE_CHECK_ACQUIRE_BIN="$mock_bin/acquire" \
  SDKGEN_GENERATE_CHECK_GENERATOR_BIN="$mock_bin/generator" \
  SDKGEN_GENERATE_CHECK_TSC_BIN="$mock_bin/tsc" \
  GENERATE_CHECK_TEST_GENERATOR_ARGS="$generator_args" \
  GENERATE_CHECK_TEST_GENERATOR_STDIN="$generator_stdin" \
  GENERATE_CHECK_TEST_TSC_ARGS="$tsc_args" \
  GENERATE_CHECK_TEST_TSC_STATUS=29 \
  "$ROOT/scripts/agent/generate-check" "$input" 2>&1
)"
typecheck_status=$?
set -e
if ((typecheck_status != 29)); then
  fail "typecheck failure exit = $typecheck_status, want 29"
fi
assert_contains "$typecheck_failure" "typecheck exit: 29"
assert_clean_temporary_root

set +e
verbose_typecheck_failure="$(
  TMPDIR="$test_tmp" \
  VERBOSE=1 \
  SDKGEN_GENERATE_CHECK_SKIP_BUILD=1 \
  SDKGEN_GENERATE_CHECK_ACQUIRE_BIN="$mock_bin/acquire" \
  SDKGEN_GENERATE_CHECK_GENERATOR_BIN="$mock_bin/generator" \
  SDKGEN_GENERATE_CHECK_TSC_BIN="$mock_bin/tsc" \
  GENERATE_CHECK_TEST_GENERATOR_ARGS="$generator_args" \
  GENERATE_CHECK_TEST_GENERATOR_STDIN="$generator_stdin" \
  GENERATE_CHECK_TEST_TSC_ARGS="$tsc_args" \
  GENERATE_CHECK_TEST_TSC_STATUS=29 \
  "$ROOT/scripts/agent/generate-check" "$input" 2>&1
)"
verbose_typecheck_status=$?
set -e
if ((verbose_typecheck_status != 29)); then
  fail "verbose typecheck failure exit = $verbose_typecheck_status, want 29"
fi
assert_contains "$verbose_typecheck_failure" "typecheck exit: 29"
assert_clean_temporary_root

set +e
missing_slot="$(
  TMPDIR="$test_tmp" \
  SDKGEN_GENERATE_CHECK_SKIP_BUILD=1 \
  SDKGEN_GENERATE_CHECK_ACQUIRE_BIN="$mock_bin/acquire" \
  SDKGEN_GENERATE_CHECK_GENERATOR_BIN="$mock_bin/generator" \
  GENERATE_CHECK_TEST_GENERATOR_ARGS="$generator_args" \
  GENERATE_CHECK_TEST_GENERATOR_STDIN="$generator_stdin" \
  GENERATE_CHECK_TEST_MISSING_SLOT=1 \
  "$ROOT/scripts/agent/generate-check" "$input" 2>&1
)"
missing_slot_status=$?
set -e
if ((missing_slot_status == 0)); then
  fail "strict consumer probe accepted a missing pagination slot"
fi
assert_contains "$missing_slot" "Property 'pagination' does not exist"
assert_clean_temporary_root

server_url_file="$test_root/server.url"
server_count_file="$test_root/server.count"
"$test_root/testserver" --input "$original" --url-output "$server_url_file" --count-output "$server_count_file" &
server_pid=$!
for _ in $(seq 1 100); do
  [[ -s "$server_url_file" ]] && break
  sleep 0.01
done
[[ -s "$server_url_file" ]] || fail "local HTTP fixture did not start"
server_url="$(cat "$server_url_file")"
http_output="$(
  TMPDIR="$test_tmp" \
  SDKGEN_GENERATE_CHECK_SKIP_BUILD=1 \
  SDKGEN_GENERATE_CHECK_ACQUIRE_BIN="$test_root/snapshot" \
  SDKGEN_GENERATE_CHECK_GENERATOR_BIN="$mock_bin/generator" \
  SDKGEN_GENERATE_CHECK_TSC_BIN="$mock_bin/tsc" \
  GENERATE_CHECK_TEST_GENERATOR_ARGS="$generator_args" \
  GENERATE_CHECK_TEST_GENERATOR_STDIN="$generator_stdin" \
  GENERATE_CHECK_TEST_TSC_ARGS="$tsc_args" \
  "$ROOT/scripts/agent/generate-check" "$server_url"
)"
if [[ "$(cat "$server_count_file")" != "1" ]]; then
  fail "HTTP root fetch count = $(cat "$server_count_file"), want 1"
fi
reported_digest="$(printf '%s\n' "$http_output" | sed -n 's/.*"sha256": "\([^"]*\)".*/\1/p')"
captured_digest="$(shasum -a 256 "$generator_stdin" | awk '{print $1}')"
if [[ "$reported_digest" != "$captured_digest" ]]; then
  fail "reported digest $reported_digest != generated snapshot digest $captured_digest"
fi
assert_clean_temporary_root

set +e
offline_output="$(
  TMPDIR="$test_tmp" \
  SDKGEN_GENERATE_CHECK_SKIP_BUILD=1 \
  SDKGEN_GENERATE_CHECK_ACQUIRE_BIN="$test_root/snapshot" \
  SDKGEN_GENERATE_CHECK_GENERATOR_BIN="$mock_bin/generator" \
  "$ROOT/scripts/agent/generate-check" "$server_url" typescript -- --offline=true 2>&1
)"
offline_status=$?
set -e
if ((offline_status == 0)); then
  fail "--offline=true unexpectedly fetched HTTP input"
fi
if [[ "$(cat "$server_count_file")" != "1" ]]; then
  fail "--offline=true performed an HTTP request"
fi
assert_contains "$offline_output" "offline"
assert_clean_temporary_root

kill "$server_pid" 2>/dev/null || true
wait "$server_pid" 2>/dev/null || true
server_pid=""

relative_root="$test_root/relative"
mkdir -p "$relative_root/schemas"
cat >"$relative_root/openapi.json" <<'EOF'
{
  "openapi":"3.2.0",
  "info":{"title":"Relative refs","version":"1"},
  "paths":{"/items":{"get":{"operationId":"listItems","responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"./schemas/item.json"}}}}}}}}
}
EOF
cat >"$relative_root/schemas/item.json" <<'EOF'
{"type":"object","properties":{"id":{"type":"string"}}}
EOF
local_relative_output="$(
  TMPDIR="$test_tmp" \
  SDKGEN_GENERATE_CHECK_SKIP_BUILD=1 \
  SDKGEN_GENERATE_CHECK_ACQUIRE_BIN="$test_root/snapshot" \
  SDKGEN_GENERATE_CHECK_GENERATOR_BIN="$test_root/openapi-sdkgen" \
  "$ROOT/scripts/agent/generate-check" "$relative_root/openapi.json"
)"
assert_contains "$local_relative_output" "generation exit: 0"
assert_contains "$local_relative_output" "typecheck exit: 0"
assert_clean_temporary_root

newline_root="$test_root/newline"
mkdir -p "$newline_root/schemas"
newline_input="$newline_root/openapi.json"$'\n'
cat >"$newline_input" <<'EOF'
{
  "openapi":"3.2.0",
  "info":{"title":"Newline path refs","version":"1"},
  "paths":{"/items":{"get":{"operationId":"listItems","responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"./schemas/item.json"}}}}}}}}
}
EOF
cp "$relative_root/schemas/item.json" "$newline_root/schemas/item.json"
newline_path_output="$(
  TMPDIR="$test_tmp" \
  SDKGEN_GENERATE_CHECK_SKIP_BUILD=1 \
  SDKGEN_GENERATE_CHECK_ACQUIRE_BIN="$test_root/snapshot" \
  SDKGEN_GENERATE_CHECK_GENERATOR_BIN="$test_root/openapi-sdkgen" \
  "$ROOT/scripts/agent/generate-check" "$newline_input"
)"
assert_contains "$newline_path_output" "generation exit: 0"
assert_contains "$newline_path_output" "typecheck exit: 0"
assert_clean_temporary_root

set +e
stdin_transport_output="$(
  TMPDIR="$test_tmp" \
  SDKGEN_GENERATE_CHECK_SKIP_BUILD=1 \
  SDKGEN_GENERATE_CHECK_ACQUIRE_BIN="$test_root/snapshot" \
  GENERATE_CHECK_TEST_AUTH=secret \
  "$ROOT/scripts/agent/generate-check" - typescript -- --http-header-env Authorization=GENERATE_CHECK_TEST_AUTH <"$relative_root/openapi.json" 2>&1
)"
stdin_transport_status=$?
set -e
if ((stdin_transport_status == 0)); then
  fail "stdin without an HTTP input base accepted root HTTP transport options"
fi
assert_contains "$stdin_transport_output" "only valid with an HTTP(S) OpenAPI input"
assert_clean_temporary_root

redirect_url_file="$test_root/redirect.url"
redirect_count_file="$test_root/redirect.count"
"$test_root/testserver" \
  --input "$relative_root/openapi.json" \
  --reference "$relative_root/schemas/item.json" \
  --required-header "Authorization=secret" \
  --redirect \
  --url-output "$redirect_url_file" \
  --count-output "$redirect_count_file" &
server_pid=$!
for _ in $(seq 1 100); do
  [[ -s "$redirect_url_file" ]] && break
  sleep 0.01
done
[[ -s "$redirect_url_file" ]] || fail "redirect HTTP fixture did not start"
redirect_url="$(cat "$redirect_url_file")"
reference_lock="$test_root/remote.lock"
redirect_output="$(
  TMPDIR="$test_tmp" \
  SDKGEN_GENERATE_CHECK_SKIP_BUILD=1 \
  SDKGEN_GENERATE_CHECK_ACQUIRE_BIN="$test_root/snapshot" \
  SDKGEN_GENERATE_CHECK_GENERATOR_BIN="$test_root/openapi-sdkgen" \
  GENERATE_CHECK_TEST_AUTH=secret \
  "$ROOT/scripts/agent/generate-check" "$redirect_url" typescript -- \
    --http-header-env Authorization=GENERATE_CHECK_TEST_AUTH \
    --ref-lock "$reference_lock" \
    --update-ref-lock
)"
assert_contains "$redirect_output" '"effectiveBase": "http://'
assert_contains "$redirect_output" "/contracts/openapi.json"
assert_contains "$redirect_output" "generation exit: 0"
assert_contains "$redirect_output" "typecheck exit: 0"
[[ -s "$reference_lock" ]] || fail "explicit reference lock was not created"
if [[ "$(cat "$redirect_count_file")" != "3" ]]; then
  fail "redirect/root/reference request count = $(cat "$redirect_count_file"), want 3"
fi
assert_clean_temporary_root

missing_lock="$test_root/missing.lock"
set +e
missing_lock_output="$(
  TMPDIR="$test_tmp" \
  SDKGEN_GENERATE_CHECK_SKIP_BUILD=1 \
  SDKGEN_GENERATE_CHECK_ACQUIRE_BIN="$test_root/snapshot" \
  SDKGEN_GENERATE_CHECK_GENERATOR_BIN="$test_root/openapi-sdkgen" \
  GENERATE_CHECK_TEST_AUTH=secret \
  "$ROOT/scripts/agent/generate-check" "$redirect_url" typescript -- \
    --http-header-env Authorization=GENERATE_CHECK_TEST_AUTH \
    --ref-lock "$missing_lock" 2>&1
)"
missing_lock_status=$?
set -e
if ((missing_lock_status == 0)); then
  fail "missing remote reference lock was accepted"
fi
assert_contains "$missing_lock_output" "reference lock"
assert_clean_temporary_root

grep -F 'ts_node node "$TYPESCRIPT_ROOT/node_modules/typescript/lib/tsc.js"' "$ROOT/scripts/agent/generate-check" >/dev/null ||
  fail "generate-check does not invoke the pinned TypeScript compiler"

agent_note "ok generate-check test"
