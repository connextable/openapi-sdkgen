{
  "openapi": "3.1.0",
  "info": {
    "title": "Hermetic after-sales pagination contract",
    "version": "1"
  },
  "paths": {
    "/after-sales-requests": {
      "get": {
        "operationId": "listAfterSalesRequests",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 2048
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/AfterSalesAdminList"
                    },
                    "meta": {
                      "type": "object",
                      "required": [
                        "requestID",
                        "pagination"
                      ],
                      "properties": {
                        "requestID": {
                          "type": "string"
                        },
                        "pagination": {
                          "$ref": "#/components/schemas/Pagination"
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        },
        "x-envelope": "data",
        "x-pagination": "cursor"
      }
    }
  },
  "components": {
    "schemas": {
      "AfterSalesAdminList": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/AfterSalesAdminListItem"
        },
        "maxItems": 100
      },
      "AfterSalesAdminListItem": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": false
      },
      "Pagination": {
        "type": "object",
        "required": [
          "nextCursor"
        ],
        "properties": {
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  }
}
